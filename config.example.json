{
  "logs": [
    { "path": "./sample.log" }
  ],
  "rules": [
    {
      "name": "error-detector",
      "pattern": "error",
      "flags": "i",
      "enabled": true
    }
  ],
  "mail": {
    "host": "smtp.example.com",
    "port": 587,
    "secure": false,
    "auth": {
      "user": "user@example.com",
      "pass": "secret"
    },
    "from": "log-alert@example.com",
    "to": "admin@example.com",
    "subject": "[log-alert] Match in ${file}: ${rule}"
  },
  "throttleMs": 5000
}
